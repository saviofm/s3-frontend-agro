{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": "./webapp",
    "paths": {
      "sap/*": ["../../node_modules/@openui5/types/types/*"]
    }
  },
  "include": ["webapp/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
